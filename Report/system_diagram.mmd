%%{init: {'theme': 'default', 'themeVariables': {'fontSize': '14px'}}}%%
graph TB
    subgraph Client["Client Layer"]
        Browser["Web Browser<br>(React 19 SPA)"]
    end

    subgraph AWS["AWS Cloud (Free Tier)"]
        subgraph CDN["Content Delivery"]
            CF["Amazon CloudFront<br>CDN & Reverse Proxy<br>(1 TB / 10M req free/month)"]
        end

        subgraph Storage["Static Storage"]
            S3["Amazon S3<br>Frontend Build Artifacts<br>(React/Vite bundle)"]
        end

        subgraph Compute["Serverless Compute"]
            APIGW["Amazon API Gateway<br>HTTP API v2<br>(1M requests/month free)"]
            Lambda["AWS Lambda<br>Containerized Express.js<br>(1M invocations/month free)<br>256 MB · 30s timeout"]
        end

        subgraph Database["NoSQL Database"]
            DDB_Users["DynamoDB<br>pm_users table<br>PAY_PER_REQUEST"]
            DDB_Projects["DynamoDB<br>pm_projects table<br>PAY_PER_REQUEST"]
            DDB_Tasks["DynamoDB<br>pm_tasks table<br>+ projectId-index GSI<br>PAY_PER_REQUEST"]
        end

        subgraph Security["Security & Access"]
            IAM["AWS IAM<br>Lambda Execution Role<br>(DynamoDB CRUD permissions)"]
        end

        subgraph Observability["Observability"]
            CW["Amazon CloudWatch<br>Lambda Execution Logs"]
        end
    end

    subgraph LocalDev["Local Development Environment"]
        Nginx["Nginx 1.27<br>Reverse Proxy<br>(port 80)"]
        Express["Express.js Backend<br>(port 3001)"]
        DDBLocal["DynamoDB Local<br>(in-memory container)"]
        Ollama["Ollama LLM Server<br>llama3.2:3b model<br>(port 11434)"]
    end

    %% Production flow
    Browser -->|"HTTPS request"| CF
    CF -->|"Static assets (index.html, JS, CSS)"| S3
    CF -->|"API requests /api/*<br>(cache disabled)"| APIGW
    APIGW -->|"AWS_PROXY integration<br>ANY /{proxy+}"| Lambda
    Lambda -->|"GetItem / PutItem / UpdateItem / DeleteItem"| DDB_Users
    Lambda -->|"GetItem / PutItem / UpdateItem / DeleteItem"| DDB_Projects
    Lambda -->|"Query (GSI) / PutItem / UpdateItem / DeleteItem"| DDB_Tasks
    Lambda -->|"Execution logs"| CW
    IAM -->|"Grants permissions"| Lambda

    %% CloudFront origins
    S3 -.->|"Origin Access Control (OAC)<br>no public access"| CF

    %% Local development flow
    Browser -->|"HTTP (dev only)"| Nginx
    Nginx -->|"Proxy /api/* requests"| Express
    Express -->|"DynamoDB SDK calls<br>(DYNAMODB_ENDPOINT override)"| DDBLocal
    Express -->|"AI chat requests<br>/api/ai/chat"| Ollama

    %% Styling
    classDef awsService fill:#FF9900,stroke:#232F3E,color:#232F3E,font-weight:bold
    classDef localService fill:#4A90D9,stroke:#1A5276,color:#fff,font-weight:bold
    classDef clientNode fill:#27AE60,stroke:#1E8449,color:#fff,font-weight:bold
    classDef groupLabel fill:#F0F0F0,stroke:#AAAAAA

    class CF,S3,APIGW,Lambda,DDB_Users,DDB_Projects,DDB_Tasks,IAM,CW awsService
    class Nginx,Express,DDBLocal,Ollama localService
    class Browser clientNode
