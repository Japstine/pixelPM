# ── AWS (production) ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Leave blank in production — the SDK will use IAM roles / environment creds
# DYNAMODB_ENDPOINT=

# DynamoDB table names (defaults used if not set)
TABLE_USERS=pm_users
TABLE_PROJECTS=pm_projects
TABLE_TASKS=pm_tasks

# Backend
PORT=3001
CORS_ORIGIN=https://your-cloudfront-domain.cloudfront.net

# Frontend (Vite build-time)
VITE_API_URL=/api
